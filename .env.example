# ---------------------------------------------------------------------------
# Life OS AI — environment variables (ALL OPTIONAL)
# The app runs fully offline with the deterministic engine. These switches
# upgrade individual features when keys are present.
# ---------------------------------------------------------------------------

# AI Coach — when set, /api/coach uses OpenAI for richer replies.
# Without it, the coach falls back to the built-in deterministic strategist.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth (Clerk) — wire up when you add accounts.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Database / realtime (Supabase) — wire up for persistence beyond localStorage.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
